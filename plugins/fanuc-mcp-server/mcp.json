{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "fanuc-mcp-server": {
      "type": "stdio",
      "command": "pythonw.exe",
      "args": ["-I", "-B", "${FANUC_MCP_INSTALL_ROOT}/StartMcp.py"],
      "cwd": "${PLUGIN_DATA}",
      "env": {"PATH": "${FANUC_MCP_INSTALL_ROOT}/python"}
    }
  }
}
