  "operations": [
    {
      "id": "workbench.programs.dependencies",
      "description": "Inspect selected LS call/run references and explicit-entry static reachability with unresolved and ambiguous definitions retained",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "entry_programs": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]{1,64}$"
            }
          },
          "view": {
            "type": "string",
            "enum": [
              "programs",
              "references",
              "issues"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "artifact_id",
          "paths",
          "entry_programs"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "contexts": [
        {
          "name": "workspace",
          "argument": "artifact_id",
          "kind": "any"
        }
      ]
    },
    {
      "id": "workbench.programs.trace",
      "description": "Trace selected LS instructions, reader/writer access, indirect references and conservative branch edges",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "view": {
            "type": "string",
            "enum": [
              "instructions",
              "accesses",
              "signals",
              "edges",
              "issues"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "artifact_id",
          "paths"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "contexts": [
        {
          "name": "workspace",
          "argument": "artifact_id",
          "kind": "any"
        }
      ]
    },
    {
      "id": "workbench.programs.explain_wait",
      "description": "Evaluate a revision-bound observed WAIT condition using preserved task, alarm and fresh sample evidence",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "observation_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "observation_index": {
            "type": "integer",
            "minimum": -1,
            "maximum": 1999
          },
          "max_age_seconds": {
            "type": "number",
            "minimum": 0,
            "maximum": 300
          }
        },
        "required": [
          "artifact_id",
          "path",
          "observation_path"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "contexts": [
        {
          "name": "workspace",
          "argument": "artifact_id",
          "kind": "any"
        }
      ]
    },
    {
      "id": "workbench.programs.triggered_captures",
      "description": "Retain bounded pre/post windows from saved diagnostic observations and match selected program revision hashes",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "observation_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "before": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "after": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "signals": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "triggers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "alarm",
                "task_pause",
                "program_transition",
                "signal_change"
              ]
            }
          },
          "view": {
            "type": "string",
            "enum": [
              "captures",
              "observations"
            ]
          },
          "capture_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 19
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "artifact_id",
          "paths",
          "observation_path"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "contexts": [
        {
          "name": "workspace",
          "argument": "artifact_id",
          "kind": "any"
        }
      ]
    },
