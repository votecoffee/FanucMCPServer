{
  "schema_version": 1,
  "id": "workbench.programs",
  "version": "1.0.0",
  "host_api": 1,
  "entrypoint": "feature.py",
  "files": {
    "feature.py": "942c55cd28446d773fd09eee985c808897e483e08284d69a55a2a52cd499a137",
    "LICENSE.txt": "9fdbc8c41abf794f69c3488f463798e06338bf90ebefbe2daee329d217c83d44"
  },
  "operations": [
    {
      "id": "workbench.programs.dependencies",
      "description": "Inspect selected LS call/run references and explicit-entry static reachability with unresolved and ambiguous definitions retained",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          },
          "entry_programs": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_]{1,64}$"
            }
          },
          "view": {
            "type": "string",
            "enum": [
              "programs",
              "references",
              "issues"
            ]
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "artifact_id",
          "paths",
          "entry_programs"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "contexts": [
        {
          "name": "workspace",
          "argument": "artifact_id",
          "kind": "any"
        }
      ]
    }
  ]
}
