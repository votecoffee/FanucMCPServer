{
  "schema_version": 1,
  "id": "workbench.alarms",
  "version": "1.0.0",
  "host_api": 1,
  "entrypoint": "feature.py",
  "files": {
    "feature.py": "5c46551469d92fcd73b8d361cf92ab9f191e29c56b9f7257a964c41c190a2cdd",
    "LICENSE.txt": "9fdbc8c41abf794f69c3488f463798e06338bf90ebefbe2daee329d217c83d44"
  },
  "operations": [
    {
      "id": "workbench.alarms.analyze",
      "description": "Analyze saved text alarm records and recurrence with explicit date/UTC-offset and source-order assumptions",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "date_order": {
            "type": "string",
            "enum": [
              "ymd",
              "mdy",
              "dmy"
            ]
          },
          "utc_offset_minutes": {
            "type": "integer",
            "minimum": -840,
            "maximum": 840
          },
          "source_order": {
            "type": "string",
            "enum": [
              "oldest_first",
              "newest_first"
            ]
          },
          "view": {
            "type": "string",
            "enum": [
              "records",
              "codes"
            ]
          },
          "code": {
            "type": "string",
            "maxLength": 16
          },
          "include_unrecognized": {
            "type": "boolean"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "artifact_id",
          "path",
          "date_order",
          "utc_offset_minutes"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "contexts": [
        {
          "name": "log",
          "argument": "artifact_id",
          "kind": "any",
          "file_argument": "path"
        }
      ]
    }
  ]
}
