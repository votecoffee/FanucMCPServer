{
  "schema_version": 1,
  "id": "workbench.alarms",
  "version": "1.1.0",
  "host_api": 1,
  "entrypoint": "feature.py",
  "files": {
    "feature.py": "acd91817f3f3d73981a96717de3cc365388c79008e94a59d2a51d273cd3a6dcd",
    "parser.py": "ae0c6b92b8fa50e02b629ea560ce9632e7e8276f1f1e4e187377c7c644cbb1eb",
    "comparison.py": "61268637b60803cf8c5cb8c0c8a546513b4d2391078e32eab88a799478f56add",
    "LICENSE.txt": "9fdbc8c41abf794f69c3488f463798e06338bf90ebefbe2daee329d217c83d44"
  },
  "operations": [
    {
      "id": "workbench.alarms.analyze",
      "description": "Analyze saved text alarm records and recurrence with explicit date/UTC-offset and source-order assumptions",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "date_order": {
            "type": "string",
            "enum": [
              "ymd",
              "mdy",
              "dmy"
            ]
          },
          "utc_offset_minutes": {
            "type": "integer",
            "minimum": -840,
            "maximum": 840
          },
          "source_order": {
            "type": "string",
            "enum": [
              "oldest_first",
              "newest_first"
            ]
          },
          "view": {
            "type": "string",
            "enum": [
              "records",
              "codes"
            ]
          },
          "code": {
            "type": "string",
            "maxLength": 16
          },
          "include_unrecognized": {
            "type": "boolean"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "artifact_id",
          "path",
          "date_order",
          "utc_offset_minutes"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "contexts": [
        {
          "name": "log",
          "argument": "artifact_id",
          "kind": "any",
          "file_argument": "path"
        }
      ]
    },
    {
      "id": "workbench.alarms.compare",
      "description": "Compare saved alarm code counts and complete severity/message pair distributions under independent explicit clocks",
      "effect": "read",
      "input_schema": {
        "type": "object",
        "properties": {
          "baseline_artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "baseline_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "baseline_clock": {
            "type": "object",
            "properties": {
              "date_order": {
                "type": "string",
                "enum": [
                  "ymd",
                  "mdy",
                  "dmy"
                ]
              },
              "utc_offset_minutes": {
                "type": "integer",
                "minimum": -840,
                "maximum": 840
              },
              "source_order": {
                "type": "string",
                "enum": [
                  "oldest_first",
                  "newest_first"
                ]
              }
            },
            "required": [
              "date_order",
              "utc_offset_minutes"
            ],
            "additionalProperties": false
          },
          "candidate_artifact_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "candidate_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "candidate_clock": {
            "type": "object",
            "properties": {
              "date_order": {
                "type": "string",
                "enum": [
                  "ymd",
                  "mdy",
                  "dmy"
                ]
              },
              "utc_offset_minutes": {
                "type": "integer",
                "minimum": -840,
                "maximum": 840
              },
              "source_order": {
                "type": "string",
                "enum": [
                  "oldest_first",
                  "newest_first"
                ]
              }
            },
            "required": [
              "date_order",
              "utc_offset_minutes"
            ],
            "additionalProperties": false
          },
          "code": {
            "type": "string",
            "maxLength": 16
          },
          "changes_only": {
            "type": "boolean"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "baseline_artifact_id",
          "baseline_path",
          "baseline_clock",
          "candidate_artifact_id",
          "candidate_path",
          "candidate_clock"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object"
      },
      "contexts": [
        {
          "name": "baseline",
          "argument": "baseline_artifact_id",
          "kind": "any",
          "file_argument": "baseline_path"
        },
        {
          "name": "candidate",
          "argument": "candidate_artifact_id",
          "kind": "any",
          "file_argument": "candidate_path"
        }
      ]
    }
  ]
}
